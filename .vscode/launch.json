{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Run Tivie",
            "program": "${workspaceFolder}/server.mjs",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "serverReadyAction": {
                "pattern": "Tivie is running at (http://127\\.0\\.0\\.1:4173)",
                "uriFormat": "%s",
                "action": "openExternally"
            }
        }
    ]
}
